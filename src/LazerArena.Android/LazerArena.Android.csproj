<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>de.lazerarena.app</ApplicationId>
    <ApplicationTitle>Lazer Arena</ApplicationTitle>
    <ApplicationVersion>13</ApplicationVersion>
    <ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RootNamespace>LazerArena.Android</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LazerArena.Presentation\LazerArena.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gemeinsamer MonoGame-Spielcode (auch im Desktop-Projekt eingebunden) -->
    <Compile Include="..\LazerArena.Game\**\*.cs" LinkBase="Game" />
  </ItemGroup>
</Project>
