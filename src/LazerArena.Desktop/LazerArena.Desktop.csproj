<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>LazerArena.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LazerArena.Presentation\LazerArena.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gemeinsamer MonoGame-Spielcode (auch im Android-Projekt eingebunden) -->
    <Compile Include="..\LazerArena.Game\**\*.cs" LinkBase="Game" />
  </ItemGroup>
</Project>
